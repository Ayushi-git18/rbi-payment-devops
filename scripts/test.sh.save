#!/bin/bash

set -e

NAMESPACE="payment-platform"

echo "Checking Kubernetes cluster..."

if ! kubectl cluster-info >/dev/null 2>&1; then
  echo "ERROR: Kubernetes cluster is not reachable."
  exit 1
fi

echo "Checking namespace..."
kubectl get namespace "$NAMESPACE"

echo "Checking deployments..."
kubectl rollout status deployment/payment-processor \
  -n "$NAMESPACE" \
  --timeout=120s

kubectl rollout status deployment/payment-gateway \
  -n "$NAMESPACE" \
  --timeout=120s

echo ""
echo "Checking pods..."
kubectl get pods -n "$NAMESPACE"

echo ""
echo "Checking services..."
kubectl get services -n "$NAMESPACE"

echo ""
echo "Checking processor endpoints..."
kubectl get endpoints payment-processor -n "$NAMESPACE"

echo ""
echo "Checking payment Secret..."
kubectl get secret payment-secret -n "$NAMESPACE"

echo ""
echo "Checking NetworkPolicy..."
kubectl get networkpolicy -n "$NAMESPACE"

echo ""
echo "Checking PodDisruptionBudgets..."
kubectl get pdb -n "$NAMESPACE"

echo ""
echo "Kubernetes validation completed successfully."#!/bin/bash

set -e

NAMESPACE="payment-platform"
GATEWAY_URL="http://localhost:8080"

echo "======================================"
echo "Payment Platform Test Suite"
echo "======================================"

echo ""
echo "1. Checking Kubernetes pods..."
kubectl get pods -n "$NAMESPACE"

echo ""
echo "2. Checking Gateway health..."
curl -fsS "$GATEWAY_URL/healthz"
echo ""

echo ""
echo "3. Checking Gateway readiness..."
curl -fsS "$GATEWAY_URL/readyz"
echo ""

echo ""
echo "4. Testing payment..."

RESPONSE=$(curl -fsS -X POST "$GATEWAY_URL/pay" \
  -H "Content-Type: application/json" \
  -H "X-Request-ID: test-script-001" \
  -d '{
    "amount": 500.00,
    "currency": "INR",
    "payer": "acc-1",
    "payee": "acc-2",
    "reference": "automated-test"
  }')

echo "$RESPONSE"

echo ""
echo "5. Checking metrics..."
curl -fsS "$GATEWAY_URL/metrics" | head -20

echo ""
echo "======================================"
echo "All basic tests completed successfully."
echo "======================================"
